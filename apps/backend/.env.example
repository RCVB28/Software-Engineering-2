# Backend environment (copy to .env; never commit .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/se2?schema=public
JWT_SECRET=change-me-in-local-and-ci
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PORT=4000
CORS_ORIGIN=http://localhost:5173
MESSAGING_MAX_RETRIES=3
MESSAGING_RETRY_DELAY_MS=200
# Audit retention scheduler (defaults shown; interval must be at least 60000 ms)
AUDIT_RETENTION_INTERVAL_MS=86400000
AUDIT_RETENTION_STARTUP_DELAY_MS=5000
