# Backend environment (copy to .env; never commit .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/se2?schema=public
JWT_SECRET=change-me-in-local-and-ci
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=
# MESSAGING_PROVIDER selects the SMS backend: "mock" (default, no real SMS), "twilio", or "textbee".
MESSAGING_PROVIDER=mock
# Required only when MESSAGING_PROVIDER=twilio. On a Twilio trial account, verify each destination
# number and use a Twilio-owned/verified sender before sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required only when MESSAGING_PROVIDER=textbee. textbee sends through an Android phone you own,
# so no sender number is needed. TEXTBEE_DEVICE_ID and TEXTBEE_BASE_URL are optional.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=
PORT=4000
CORS_ORIGIN=http://localhost:5173
MESSAGING_MAX_RETRIES=3
MESSAGING_RETRY_DELAY_MS=200
# Number of simulated failures for the mock provider (useful for exercising retry logic).
MESSAGING_MOCK_FAILURES=0
