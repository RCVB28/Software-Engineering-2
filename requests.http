# Local API requests (VS Code REST Client)
# Set @adminToken after POST /api/auth/admin/login.

@baseUrl = http://localhost:4000
@adminToken = <paste-admin-jwt>
@residentToken = <paste-resident-jwt>

### Health
GET {{baseUrl}}/api/health

### Admin login (seeded superadmin)
POST {{baseUrl}}/api/auth/admin/login
Content-Type: application/json

{
  "email": "superadmin@example.com",
  "password": "Password123!"
}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{adminToken}}

### Barangays
GET {{baseUrl}}/api/barangays
Authorization: Bearer {{adminToken}}

### Create alert draft
POST {{baseUrl}}/api/admin/alerts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "content": "Evacuate the building immediately.",
  "category": "FIRE",
  "targets": [{ "barangayId": "<barangay-id>", "residentRole": "RESIDENT" }]
}

### Preview recipients
GET {{baseUrl}}/api/admin/alerts/<alert-id>/recipients
Authorization: Bearer {{adminToken}}

### Confirm broadcast
POST {{baseUrl}}/api/admin/alerts/<alert-id>/confirm
Authorization: Bearer {{adminToken}}

### Delivery outcomes
GET {{baseUrl}}/api/admin/alerts/<alert-id>/deliveries
Authorization: Bearer {{adminToken}}

### Submit a report (resident)
POST {{baseUrl}}/api/reports
Authorization: Bearer {{residentToken}}
Content-Type: application/json

{
  "category": "FLOOD",
  "severity": "HIGH",
  "description": "Knee-deep flooding along the main road.",
  "addressText": "Poblacion Main Street"
}

### Admin report triage
GET {{baseUrl}}/api/admin/reports
Authorization: Bearer {{adminToken}}

### Update report status
PATCH {{baseUrl}}/api/admin/reports/<report-id>/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "ACKNOWLEDGED"
}

### Edit a saved draft
PATCH {{baseUrl}}/api/admin/alerts/<alert-id>
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "content": "Updated evacuation instructions.",
  "category": "FLOOD",
  "targets": [{ "barangayId": "<barangay-id>", "residentRole": null }]
}

### Administrative alert history with filters
GET {{baseUrl}}/api/admin/alerts/history?status=COMPLETED&category=FLOOD&barangayId=<barangay-id>&from=2026-01-01T00:00:00.000Z&to=2026-12-31T23:59:59.999Z&q=evacuate&page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Failure notifications
GET {{baseUrl}}/api/admin/notifications?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Unread failure notifications
GET {{baseUrl}}/api/admin/notifications?unreadOnly=true
Authorization: Bearer {{adminToken}}

### Acknowledge a failure notification
POST {{baseUrl}}/api/admin/notifications/<notification-id>/acknowledge
Authorization: Bearer {{adminToken}}

### Resident personal alert history
GET {{baseUrl}}/api/residents/me/alert-history?page=1&pageSize=10
Authorization: Bearer {{residentToken}}